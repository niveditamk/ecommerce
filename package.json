{
  "name": "aurelis-maison",
  "private": true,
  "version": "1.0.0",
  "description": "AURELIS - a luxury e-commerce storefront in React with a Node/Express API. Liquid-glass design system.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "node server/src/index.js",
    "preview": "npm run build && npm run start",
    "build:all": "npm --workspace client run build",
    "dev:shop": "node scripts/dev.mjs --no-medusa"
  },
  "engines": {
    "node": ">=22.13"
  }
}
